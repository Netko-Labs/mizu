# Mizu Minato - Sample Environment Configuration
# Copy this file to .env and update values as needed

# Authentication
AUTH_SECRET=your-super-secret-auth-key-here-min-32-chars

# Application
BASE_URL=http://localhost:3000

# Database (PostgreSQL)
# Default port 19432 to avoid conflicts with other services
DATABASE_URL=postgresql://postgres:postgres@localhost:19432/mizu

# Cache (Redis)
# Default port 19379 to avoid conflicts with other services
CACHE_URL=redis://localhost:19379

# Encryption key for sensitive data
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# Nagare daemon origin (the frontend's Eden Treaty client + WS target)
VITE_NAGARE_URL=http://localhost:3001

# Optional: Trusted origins for CORS (comma-separated)
# TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: social login providers (enabled when both values are set)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
