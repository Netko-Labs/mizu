# Mizu Nagare (流れ) - Sample Environment Configuration
# Copy this file to .env and update values as needed

# Environment
NODE_ENV=development

# Daemon port
PORT=3001

# Database (PostgreSQL) — the SAME database minato uses; nagare owns the
# business tables, minato owns the auth tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:19432/mizu

# Minato's origin — used to fetch the JWKS (/api/auth/jwks) and as the JWT
# issuer/audience. Must match minato's BASE_URL exactly (no trailing slash).
WEB_BASE_URL=http://localhost:3000

# Allowed browser origins (comma-separated)
CORS=http://localhost:3000

# Encryption key for sensitive data (database credentials at rest).
# Moved here from minato — deployments and env resolution run in nagare.
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# Optional: Cloudflare API token (Zone:DNS:Edit for your domain) — enables
# automatic wildcard HTTPS (*.domain) on the ingress via DNS-01 validation.
# CLOUDFLARE_API_TOKEN=
