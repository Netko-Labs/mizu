{
  "name": "nagare-app",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsgo --noEmit",
    "dev": "bun run repo dev --app nagare",
    "serve": "bun run repo serve --app nagare",
    "build": "bun run repo build --app nagare",
    "start": "NODE_ENV=production bun run src/index.ts",
    "infra:up": "bun run repo infra:up --app nagare",
    "infra:down": "bun run repo infra:down --app nagare",
    "db:migrate": "bun run repo db:migrate --app nagare",
    "db:generate": "bun run repo db:generate --app nagare",
    "db:push": "bun run repo db:push --app nagare"
  },
  "dependencies": {
    "@mizu/logger": "workspace:*",
    "@mizu/nagare-api": "workspace:*",
    "@mizu/nagare-config": "workspace:*",
    "@mizu/nagare-domain": "workspace:*",
    "@mizu/nagare-service": "workspace:*",
    "elysia": "2.0.0-exp.25"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.2"
  }
}
