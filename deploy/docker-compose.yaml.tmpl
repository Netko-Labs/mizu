# Mizu Docker Compose Configuration
# Generated by install.sh - do not edit manually

version: '3.8'

services:
  mizu-proxy:
    image: caddy:2-alpine
    container_name: mizu-proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - mizu-app
    networks:
      - mizu-network

  mizu-app:
    image: ghcr.io/mizudev/mizu:latest
    container_name: mizu-app
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - DATABASE_URL=postgresql://mizu:${MIZU_DB_PASSWORD}@mizu-db:5432/mizu
      - ENCRYPTION_KEY=${MIZU_ENCRYPTION_KEY}
      - BETTER_AUTH_SECRET=${MIZU_AUTH_SECRET}
      - BETTER_AUTH_URL=https://${MIZU_DOMAIN}
      - MIGRATE_ON_START=true
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    depends_on:
      - mizu-db
    networks:
      - mizu-network

  mizu-db:
    image: postgres:16-alpine
    container_name: mizu-db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=mizu
      - POSTGRES_PASSWORD=${MIZU_DB_PASSWORD}
      - POSTGRES_DB=mizu
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - mizu-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mizu"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
  caddy_data:
  caddy_config:

networks:
  mizu-network:
    driver: bridge
